# Auto detect text files and normalize line endings to LF
# This will handle all files NOT found below
* text=auto

# Serialized DAO block data
p2p/src/main/resources/BsqBlocks_BTC_MAINNET/** binary

 # Serialized persisted stores
p2p/src/main/resources/*Store* binary

*.aiff binary
*.ttf  binary
*.gpg  binary
*.tiff binary
*.zip  binary
*.dat binary

# These text files should retain Windows line endings (CRLF)
*.bat           text eol=crlf
gradlew         text eol=lf
gradle/wrapper/gradle-wrapper.properties text eol=lf
gradle/wrapper/*.sha256 text eol=lf
# These binary files should be left untouched
# (binary is a macro for -text -diff)
*.bmp           binary
*.gif           binary
*.ico           binary
*.jar           binary
*.jpg           binary
*.jpeg          binary
*.png           binary
